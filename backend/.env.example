DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chique_detalhes
# Generate a unique random secret of at least 32 characters. Never commit real credentials.
JWT_SECRET=
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chiquedetalhes.com.br,https://www.chiquedetalhes.com.br
# S3-compatible Railway bucket (keep all values only in the Backend service).
STORAGE_ENDPOINT=https://t3.storageapi.dev
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional CDN/custom public URL. Otherwise endpoint/bucket/key is returned.
STORAGE_PUBLIC_BASE_URL=
# Set only after verifying the reverse proxy topology.
TRUST_PROXY_HOPS=
