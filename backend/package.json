{
  "name": "backend",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "db:sync": "prisma db push",
    "db:upgrade": "prisma db execute --file prisma/upgrades/20260920_users.sql --schema prisma/schema.prisma && prisma db execute --file prisma/upgrades/20260921_cash_flow.sql --schema prisma/schema.prisma && prisma db execute --file prisma/upgrades/20260921_sales_portal.sql --schema prisma/schema.prisma",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx src/index.ts",
    "postinstall": "npx prisma generate"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.862.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
