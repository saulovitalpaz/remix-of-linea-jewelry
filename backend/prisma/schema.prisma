generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String?  @unique
  name         String
  username     String   @unique
  role         String   @default("SELLER")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  emoji       String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  description String?
  imageUrl    String?
  stock       Int      @default(0)
  salesCount  Int      @default(0)
  featured    Boolean  @default(false)
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailySales {
  id               String            @id @default(uuid())
  date             DateTime          @default(now())
  totalRevenue     Float
  itemsSold        Int
  notes            String?
  userId           String?
  userName         String?
  createdAt        DateTime          @default(now())
  cashTransactions CashTransaction[]
}

model CashTransaction {
  id            String      @id @default(uuid())
  type          String      // 'INFLOW' | 'OUTFLOW'
  category      String      // 'SALE' | 'EXPENSE' | 'WITHDRAWAL' | 'SUPPLY' | 'OTHER'
  amount        Float
  description   String
  date          DateTime    @default(now())
  paymentMethod String?     // 'DINHEIRO' | 'PIX' | 'CARTAO_CREDITO' | 'CARTAO_DEBITO' | 'OUTRO'
  notes         String?
  userId        String?
  userName      String
  userRole      String
  dailySalesId  String?
  dailySales    DailySales? @relation(fields: [dailySalesId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([date])
  @@index([type])
  @@index([userId])
}

model MarketingPopup {
  id        String   @id @default(uuid())
  imageUrl  String
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
